{
  "name": "dental-xray-insights",
  "version": "1.0.0",
  "description": "Dental X-ray AI analysis tool - preliminary insights only, not a medical diagnosis",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc && cp -r public dist/",
    "start": "node dist/server.js",
    "dev": "tsx watch src/main.ts",
    "dev:server": "tsx watch server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "health": "tsx src/main.ts health",
    "analyze": "tsx src/main.ts analyze",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "firebase": "^13.4.0",
    "helmet": "^7.1.0",
    "multer": "^2.0.0",
    "sharp": "^0.33.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}